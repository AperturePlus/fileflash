FF_DB_URI=postgresql://root:password@localhost:5432/fileflash
# DATABASE_URL takes precedence over FF_DB_URI when both are set.
# DATABASE_URL=postgresql://root:password@localhost:5432/fileflash

JWT_SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
# RabbitMQ is optional in this stage, kept for future publisher swap.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Optional SMTP settings for real email delivery.
# MAIL_FROM=no-reply@example.com
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SERVER=
# MAIL_PORT=587
