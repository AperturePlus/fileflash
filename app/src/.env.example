FF_DB_URI=postgresql://root:password@localhost:5432/fileflash
# DATABASE_URL takes precedence over FF_DB_URI when both are set.
# DATABASE_URL=postgresql://root:password@localhost:5432/fileflash

JWT_SECRET_KEY=please-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=redis://localhost:6379/0
# RabbitMQ is optional in this stage, kept for future publisher swap.
# RABBITMQ_URL=amqp://guest:guest@localhost:5672/

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2
WORKER_TASK_TIMEOUT_SECONDS=900
WORKER_DEFAULT_MAX_ATTEMPTS=5
WORKER_RETRY_BACKOFF_SECONDS=30,120,600,1800,7200
WORKER_QUEUE_STREAM=fileflash:tasks
WORKER_QUEUE_GROUP=fileflash-workers
WORKER_QUEUE_BLOCK_MS=5000

# Optional binary override for media tasks.
# FFMPEG_BINARY=ffmpeg
# FFPROBE_BINARY=ffprobe

# Optional SMTP settings for real email delivery.
# MAIL_FROM=no-reply@example.com
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SERVER=
# MAIL_PORT=587
