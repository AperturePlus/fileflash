{
  "name": "fileflash-web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.2.8",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check": "vue-tsc --noEmit",
    "electron:dev": "concurrently -k \"cross-env VITE_APP_RUNTIME=electron vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 VITE_APP_RUNTIME=electron electron .\"",
    "electron:build": "cross-env VITE_APP_RUNTIME=electron bun run build && electron-builder --dir",
    "electron:dist": "cross-env VITE_APP_RUNTIME=electron bun run build && electron-builder"
  },
  "dependencies": {
    "@types/spark-md5": "^3.0.5",
    "@vueuse/core": "^13.5.0",
    "axios": "^1.10.0",
    "hls.js": "^1.6.15",
    "js-cookie": "^3.0.5",
    "jszip": "^3.10.1",
    "mockjs": "^1.1.0",
    "pdfjs-dist": "^5.6.205",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "qs": "^6.14.0",
    "spark-md5": "^3.0.2",
    "viewerjs": "^1.11.7",
    "vue": "^3.5.17",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/js-cookie": "^3.0.6",
    "@types/mockjs": "^1.0.10",
    "@types/qs": "^6.14.0",
    "@types/vue-router": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^41.1.0",
    "electron-builder": "^26.8.1",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vue-tsc": "^2.2.12",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.fileflash.desktop",
    "productName": "FileFlash",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.mjs"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
